# ============================================================
# AquaWise Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# Do NOT commit `.env` containing secret credentials to Git.

# Google Weather API (Optional - automatically falls back to Open-Meteo if omitted)
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_here

# Standards-based Web Push Notifications (VAPID)
# Generate a new P-256 keypair by running: python backend/generate_vapid_keys.py
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_PRIVATE_KEY="your_vapid_private_key_pem_or_base64"
VAPID_CLAIMS_SUB=mailto:farmer-support@aquawise.farm

# Optional Server Settings
# HOST=0.0.0.0
# PORT=5000
